# ─────────────────────────────────────────────────────────────────────────────
# Akashic Library – Environment Variable Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True

# Allowed hosts (comma-separated; leave empty for local dev only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL (transactional / identity data) ───────────────────────────────
POSTGRES_DB=akashic_library
POSTGRES_USER=akashic_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── MongoDB (book-discovery / community documents) ───────────────────────────
MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=akashic_discovery

# ─── External provider API keys (optional) ───────────────────────────────────
# Google Books API key — optional; works without it at lower rate limits.
# NEVER commit a real key to version control.
GOOGLE_BOOKS_API_KEY=

# ─── CORS (React dev server) ──────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-site requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
