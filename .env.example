# ─────────────────────────────────────────────────────────────────────────────
# Akashic Library – Environment Variable Template
#
# Copy this file to .env and supply actual deployment values.
# NEVER commit .env to version control or publish real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core & Security ──────────────────────────────────────────────────
# Set to Akashic_Library.production_settings in production
DJANGO_SETTINGS_MODULE=Akashic_Library.settings
# Long, cryptographically random string (min 50 chars recommended)
DJANGO_SECRET_KEY=replace-with-a-secure-50-character-cryptographic-secret-key
DJANGO_DEBUG=False

# Allowed hosts (comma-separated; NO wildcards in production)
DJANGO_ALLOWED_HOSTS=akashic.example.com,www.akashic.example.com

# CSRF Trusted Origins (comma-separated with scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=https://akashic.example.com,https://www.akashic.example.com

# Frontend URL (used for password reset emails and canonical links)
FRONTEND_URL=https://akashic.example.com

# ─── HTTPS & Security Headers (Production) ───────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
BEHIND_REVERSE_PROXY=True
ENABLE_HSTS=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ─── PostgreSQL (Relational Identity & Commerce) ──────────────────────────────
POSTGRES_DB=akashic_library
POSTGRES_USER=akashic_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# ─── MongoDB (Discovery Catalog & Community Documents) ────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_NAME=akashic_discovery

# ─── Email Delivery (Account Recovery & Notifications) ────────────────────────
# Use console backend for development; smtp for production
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey-or-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-api-key-or-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Akashic Library <noreply@akashic.example.com>
PASSWORD_RESET_TIMEOUT=86400

# ─── External Provider API Keys (Optional) ────────────────────────────────────
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_TIMEOUT=8
OPEN_LIBRARY_TIMEOUT=8

# ─── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────
# Only required if frontend and backend are hosted on distinct origins.
# For same-origin reverse proxy deployments, leave empty.
CORS_ALLOWED_ORIGINS=

# ─── E2E Testing Isolation (Optional / Disposable Test Runner) ─────────────────
# Loaded only when running with Akashic_Library.e2e_settings
E2E_POSTGRES_DB=akashic_library_e2e
E2E_MONGODB_NAME=akashic_discovery_e2e
E2E_TEST_PASSWORD=
