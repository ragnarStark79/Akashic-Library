# Akashic Library Frontend Environment Variables Template
#
# NOTICE: All VITE_* variables are embedded into public browser bundles.
# NEVER place backend secrets, database passwords, or private API keys here.

# API Base URL:
# For same-origin reverse-proxy deployment (Recommended): /api
# For decoupled cross-origin deployment: https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# Data Mode:
# 'api' - Active Django REST backend integration (Production / Standard)
# 'demo' - Isolated mock fixtures for frontend UI development without backend
VITE_DISCOVERY_DATA_MODE=api
